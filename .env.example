# Copy to .env. Never commit .env.
# Leave the SMTP host empty and `pulseguard run` will not send mail.
# Set STARTTLS to true only when the server expects it. The password stays here.
PULSEGUARD_LOG_LEVEL=INFO
PULSEGUARD_SMTP_HOST=
PULSEGUARD_SMTP_PORT=587
PULSEGUARD_SMTP_USERNAME=
PULSEGUARD_SMTP_PASSWORD=
PULSEGUARD_SMTP_FROM=
PULSEGUARD_SMTP_TO=
PULSEGUARD_SMTP_STARTTLS=false
# Web process. All four are required by `pulseguard web`. Leave them empty until then.
# The password is hashed at startup. The session key and API key are not logged.
PULSEGUARD_SECRET_KEY=
PULSEGUARD_ADMIN_USER=
PULSEGUARD_ADMIN_PASSWORD=
PULSEGUARD_API_KEY=
# Agent collector token. Required only with `pulseguard run --agent-listen`.
# Use 16-128 letters, digits, underscores, or hyphens. Do not commit a real token.
PULSEGUARD_AGENT_TOKEN=
# Optional MySQL backend. Leave the host empty to keep using SQLite.
# The password stays in this uncommitted file. The CLI does not read these yet.
PULSEGUARD_MYSQL_HOST=
PULSEGUARD_MYSQL_PORT=3306
PULSEGUARD_MYSQL_USER=
PULSEGUARD_MYSQL_PASSWORD=
PULSEGUARD_MYSQL_DATABASE=
