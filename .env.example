# Copy to .env. Never commit .env.
# SMTP settings are unused until the email notifier is built.
PULSEGUARD_LOG_LEVEL=INFO
PULSEGUARD_SMTP_HOST=
PULSEGUARD_SMTP_PORT=587
PULSEGUARD_SMTP_USERNAME=
PULSEGUARD_SMTP_PASSWORD=
# Optional MySQL backend. Leave the host empty to keep using SQLite.
# The password stays in this uncommitted file. The CLI does not read these yet.
PULSEGUARD_MYSQL_HOST=
PULSEGUARD_MYSQL_PORT=3306
PULSEGUARD_MYSQL_USER=
PULSEGUARD_MYSQL_PASSWORD=
PULSEGUARD_MYSQL_DATABASE=
